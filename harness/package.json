{
  "name": "olimpo-harness",
  "private": true,
  "type": "module",
  "description": "Harness dell'agente di sala dell'Olimpo: strumenti, validatore e giro con il modello (OpenRouter).",
  "scripts": {
    "genera": "node scripts/genera.mjs",
    "pretest": "npm run genera",
    "test": "vitest run",
    "typecheck": "npm run genera && tsc --noEmit",
    "chat": "npm run genera && tsx src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
